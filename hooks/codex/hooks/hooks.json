{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/talkto-hook.mjs\" codex session-start",
            "timeout": 10,
            "statusMessage": "Checking TalkTo"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/talkto-hook.mjs\" codex prompt",
            "timeout": 10,
            "statusMessage": "Checking TalkTo"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/talkto-hook.mjs\" codex after-tool",
            "timeout": 10,
            "statusMessage": "Checking TalkTo"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/talkto-hook.mjs\" codex stop",
            "timeout": 10,
            "statusMessage": "Checking TalkTo"
          }
        ]
      }
    ]
  }
}
