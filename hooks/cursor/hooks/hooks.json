{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"$CURSOR_PLUGIN_ROOT/scripts/talkto-hook.mjs\" cursor session-start",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "node \"$CURSOR_PLUGIN_ROOT/scripts/talkto-hook.mjs\" cursor after-tool",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node \"$CURSOR_PLUGIN_ROOT/scripts/talkto-hook.mjs\" cursor stop",
        "timeout": 10,
        "loop_limit": 3
      }
    ]
  }
}
